APP_ENV=development
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag

# Use "local" for the keyless deterministic demo or "openai" for real AI answers.
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

MAX_UPLOAD_MB=15
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=5

